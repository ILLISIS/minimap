{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "node16",
		"target": "es2022",
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist/node"
	},
	"include": [
		"./*.ts", "./shared/**/*.ts", "./store/**/*.ts", "./s3/**/*.ts", "./web/view/**/*.ts", "./test/unit/**/*.ts"
	],
	"exclude": ["./dist/*"]
}
